# Plantilla de variables de entorno. NO rellenes este archivo con datos reales ni lo subas:
# en Hostinger se ponen en hPanel > App web de Node.js > Variables de entorno.
# En local, copia este archivo a `.env` (está en .gitignore) y ajusta.

# Qué web es (columna `sitio` de la tabla envios)
SITIO_ID=karayapuntacana.com

# MySQL del Hostinger del cliente (hPanel > Bases de datos). En Hostinger el host suele ser localhost.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u000000000_karaya        # EJEMPLO: el usuario real lo da hPanel
DB_PASSWORD=CAMBIAR_ESTA_CLAVE   # EJEMPLO (también vale el nombre DB_PASS)
DB_NAME=u000000000_web           # EJEMPLO: la misma base para las 3 webs

# Correo de Hostinger (hPanel > Correo electrónico). OPCIONAL: si el SMTP no está completo (o falla),
# los envíos se guardan igual en la base (con correo = 0) y se ven en /admin/solicitudes. Hoy
# karayapuntacana.com no tiene buzón: dejar estas variables vacías hasta que Fernando lo active.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=web@karayapuntacana.com   # EJEMPLO: cuenta que hay que crear
SMTP_PASSWORD=CAMBIAR_ESTA_CLAVE    # EJEMPLO

# De quién sale el aviso y a quién llega (todavía no se sabe cuáles: valores de ejemplo)
MAIL_FROM="Karaya Web <web@karayapuntacana.com>"
MAIL_TO=ventas@karayapuntacana.com   # EJEMPLO; varias separadas por comas

# Página privada /admin/solicitudes (Basic Auth). Sin estas dos, la ruta no existe (404).
ADMIN_USER=karaya
ADMIN_PASS=CAMBIAR_POR_UNA_CLAVE_LARGA   # EJEMPLO

# Antispam (opcionales)
HASH_SALT=CAMBIAR_POR_UNA_CADENA_LARGA_Y_ALEATORIA
LIMITE_POR_HORA=5
TIEMPO_MINIMO_MS=3000
TRUST_PROXY=1
